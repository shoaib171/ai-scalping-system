//@version=6
// Volume profile with buy/sell split from candle close location. Uses the chart's own volume (OANDA: tick volume).
indicator("VP Buy/Sell Profile", "VP B/S", overlay = true, max_boxes_count = 500, max_lines_count = 50, max_labels_count = 50, max_bars_back = 2000)

mode    = input.string("Day", "Profile range", options = ["Day", "Last N bars"])
nBars   = input.int(150, "N bars (Last N bars mode)", minval = 20, maxval = 1500)
rows    = input.int(40, "Rows", minval = 10, maxval = 120)
vaPct   = input.float(70, "Value area %", minval = 50, maxval = 95) / 100
widthB  = input.int(40, "Profile width (bars)", minval = 10, maxval = 200)
offsetB = input.int(5, "Gap after last bar", minval = 0, maxval = 100)
cBuy    = input.color(color.new(color.teal, 35), "Buy volume")
cSell   = input.color(color.new(color.red, 35), "Sell volume")
cPoc    = input.color(color.orange, "POC")
cVa     = input.color(color.new(color.orange, 40), "VAH / VAL")
ladderN = input.int(15, "Ladder rows", minval = 5, maxval = 30, group = "Auction ladder")
ladPos  = input.string("Bottom right", "Ladder position", options = ["Top right", "Middle right", "Bottom right", "Bottom left", "Top left"], group = "Auction ladder")
recentN = input.int(6, "Recent delta bars", minval = 2, maxval = 50, group = "Auction ladder")
imbX    = input.float(2.0, "Imbalance ratio", minval = 1.2, maxval = 10, group = "Auction ladder")

var int anchor = na
if na(anchor) or (mode == "Day" and timeframe.change("D"))
    anchor := bar_index

// Buy share = where the candle closed inside its range (close at high = all buy, close at low = all sell).
rng = high - low
bv  = rng > 0 ? volume * (close - low) / rng : (close >= open ? volume : 0.0)
sv  = volume - bv

var array<box>   boxes = array.new<box>()
var array<line>  lns   = array.new<line>()
var array<label> lbs   = array.new<label>()
var table tb = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 15), border_width = 1)

posOf(s) => s == "Top right" ? position.top_right : s == "Middle right" ? position.middle_right : s == "Bottom right" ? position.bottom_right : s == "Bottom left" ? position.bottom_left : position.top_left
var table ld = table.new(posOf(ladPos), 5, 40, bgcolor = color.new(color.black, 15), border_width = 1)

f(x) => str.tostring(x, format.mintick)
fp(x) => str.tostring(x, "#.##")
fn(x) => str.tostring(math.round(x), "#,###")
fd(x) => (x >= 0 ? "+" : "") + str.tostring(math.round(x), "#,###")
fv(x) => str.tostring(x, format.volume)

if barstate.islast
    for b in boxes
        b.delete()
    boxes.clear()
    for l in lns
        l.delete()
    lns.clear()
    for lb in lbs
        lb.delete()
    lbs.clear()

    start = mode == "Day" ? anchor : math.max(0, bar_index - nBars + 1)
    len   = math.min(bar_index - start + 1, 1999)
    float top = high
    float bot = low
    for i = 0 to len - 1
        top := math.max(top, high[i])
        bot := math.min(bot, low[i])
    step = (top - bot) / rows

    if step > 0
        buy  = array.new_float(rows, 0.0)
        sell = array.new_float(rows, 0.0)
        for i = 0 to len - 1
            r0 = math.min(rows - 1, math.max(0, int((low[i] - bot) / step)))
            r1 = math.min(rows - 1, math.max(0, int((high[i] - bot) / step)))
            n  = r1 - r0 + 1
            for r = r0 to r1
                buy.set(r, buy.get(r) + bv[i] / n)
                sell.set(r, sell.get(r) + sv[i] / n)

        pocIdx = 0
        maxTot = 0.0
        totAll = 0.0
        totBuy = 0.0
        bestBuy = 0
        bestSell = 0
        for r = 0 to rows - 1
            t = buy.get(r) + sell.get(r)
            totAll += t
            totBuy += buy.get(r)
            if t > maxTot
                maxTot := t
                pocIdx := r
            if buy.get(r) - sell.get(r) > buy.get(bestBuy) - sell.get(bestBuy)
                bestBuy := r
            if sell.get(r) - buy.get(r) > sell.get(bestSell) - buy.get(bestSell)
                bestSell := r

        lo  = pocIdx
        hi  = pocIdx
        acc = maxTot
        while acc < totAll * vaPct and (lo > 0 or hi < rows - 1)
            up = hi < rows - 1 ? buy.get(hi + 1) + sell.get(hi + 1) : -1.0
            dn = lo > 0 ? buy.get(lo - 1) + sell.get(lo - 1) : -1.0
            if up >= dn
                hi += 1
                acc += up
            else
                lo -= 1
                acc += dn

        poc = bot + step * (pocIdx + 0.5)
        vah = bot + step * (hi + 1)
        val = bot + step * lo
        x0  = bar_index + offsetB

        for r = 0 to rows - 1
            b  = buy.get(r)
            s  = sell.get(r)
            wB = int(math.round(b / maxTot * widthB))
            wS = int(math.round(s / maxTot * widthB))
            inVa = r >= lo and r <= hi
            yTop = bot + step * (r + 1)
            yBot = bot + step * r
            if wB > 0
                boxes.push(box.new(x0, yTop, x0 + wB, yBot, border_color = na, bgcolor = inVa ? cBuy : color.new(cBuy, 75)))
            if wS > 0
                boxes.push(box.new(x0 + wB, yTop, x0 + wB + wS, yBot, border_color = na, bgcolor = inVa ? cSell : color.new(cSell, 75)))

        xEnd = x0 + widthB
        lns.push(line.new(start, poc, xEnd, poc, color = cPoc, width = 2))
        lns.push(line.new(start, vah, xEnd, vah, color = cVa, style = line.style_dashed))
        lns.push(line.new(start, val, xEnd, val, color = cVa, style = line.style_dashed))
        lbs.push(label.new(xEnd, poc, "POC " + f(poc), style = label.style_label_left, color = color.new(color.white, 100), textcolor = cPoc, size = size.small))
        lbs.push(label.new(xEnd, vah, "VAH " + f(vah), style = label.style_label_left, color = color.new(color.white, 100), textcolor = cPoc, size = size.small))
        lbs.push(label.new(xEnd, val, "VAL " + f(val), style = label.style_label_left, color = color.new(color.white, 100), textcolor = cPoc, size = size.small))

        totSell = totAll - totBuy
        delta   = totBuy - totSell
        cTxt = color.white
        table.cell(tb, 0, 0, "Range", text_color = cTxt, text_size = size.small)
        table.cell(tb, 1, 0, mode == "Day" ? "Today" : "Last " + str.tostring(len) + " bars", text_color = cTxt, text_size = size.small)
        table.cell(tb, 0, 1, "Buy vol", text_color = cTxt, text_size = size.small)
        table.cell(tb, 1, 1, fv(totBuy), text_color = color.teal, text_size = size.small)
        table.cell(tb, 0, 2, "Sell vol", text_color = cTxt, text_size = size.small)
        table.cell(tb, 1, 2, fv(totSell), text_color = color.red, text_size = size.small)
        table.cell(tb, 0, 3, "Delta", text_color = cTxt, text_size = size.small)
        table.cell(tb, 1, 3, (delta >= 0 ? "+" : "") + fv(delta) + " (" + str.tostring(delta / totAll * 100, "#.#") + "%)", text_color = delta >= 0 ? color.teal : color.red, text_size = size.small)
        table.cell(tb, 0, 4, "POC", text_color = cTxt, text_size = size.small)
        table.cell(tb, 1, 4, f(poc), text_color = cPoc, text_size = size.small)
        table.cell(tb, 0, 5, "VAH / VAL", text_color = cTxt, text_size = size.small)
        table.cell(tb, 1, 5, f(vah) + " / " + f(val), text_color = cPoc, text_size = size.small)
        table.cell(tb, 0, 6, "Buyers strongest", text_color = cTxt, text_size = size.small)
        table.cell(tb, 1, 6, f(bot + step * (bestBuy + 0.5)), text_color = color.teal, text_size = size.small)
        table.cell(tb, 0, 7, "Sellers strongest", text_color = cTxt, text_size = size.small)
        table.cell(tb, 1, 7, f(bot + step * (bestSell + 0.5)), text_color = color.red, text_size = size.small)
        table.cell(tb, 0, 8, "Volume", text_color = cTxt, text_size = size.small)
        table.cell(tb, 1, 8, syminfo.volumetype == "tick" ? "Tick (estimate)" : "Real", text_color = color.gray, text_size = size.small)

        // Auction ladder: buy/sell volume per price row around the current price.
        ld.clear(0, 0, 4, 39)
        recent = 0.0
        for i = 0 to math.min(recentN, len) - 1
            recent += bv[i] - sv[i]
        state = close > vah ? "Above value" : close < val ? "Below value" : "Inside value (balance)"
        flow = close > vah ? (recent >= 0 ? "Initiative buying: trend up" : "Responsive selling: back to value?") : close < val ? (recent <= 0 ? "Initiative selling: trend down" : "Responsive buying: back to value?") : (recent >= 0 ? "Rotation, buyers leaning" : "Rotation, sellers leaning")
        stCol = close > vah ? color.teal : close < val ? color.red : color.orange
        tz = size.small
        ld.cell(0, 0, "Auction", text_color = cTxt, text_size = tz)
        ld.cell(1, 0, state, text_color = stCol, text_size = tz)
        ld.cell(0, 1, "Flow " + str.tostring(recentN) + " bars", text_color = cTxt, text_size = tz)
        ld.cell(1, 1, flow, text_color = recent >= 0 ? color.teal : color.red, text_size = tz)
        ld.cell(2, 1, fd(recent), text_color = recent >= 0 ? color.teal : color.red, text_size = tz)
        ld.cell(0, 2, "Live bar", text_color = cTxt, text_size = tz)
        ld.cell(1, 2, "Sell " + fn(sv), text_color = color.red, text_size = tz)
        ld.cell(2, 2, "Buy " + fn(bv), text_color = color.teal, text_size = tz)
        ld.cell(3, 2, fd(bv - sv), text_color = bv >= sv ? color.teal : color.red, text_size = tz)
        ld.cell(0, 3, "Price", text_color = cTxt, text_size = tz)
        ld.cell(1, 3, "Sell", text_color = color.red, text_size = tz)
        ld.cell(2, 3, "Buy", text_color = color.teal, text_size = tz)
        ld.cell(3, 3, "Delta", text_color = cTxt, text_size = tz)
        ld.cell(4, 3, "Note", text_color = cTxt, text_size = tz)

        cr  = math.min(rows - 1, math.max(0, int((close - bot) / step)))
        hiR = math.min(rows - 1, cr + int(ladderN / 2))
        loR = math.max(0, hiR - ladderN + 1)
        hiR := math.min(rows - 1, loR + ladderN - 1)
        mx = 0.0
        for r = loR to hiR
            mx := math.max(mx, math.max(buy.get(r), sell.get(r)))
        rowI = 4
        for r = hiR to loR
            b = buy.get(r)
            s = sell.get(r)
            tag = ""
            if r == cr
                tag += "◀ PRICE "
            if r == pocIdx
                tag += "POC "
            if r == hi
                tag += "VAH "
            if r == lo
                tag += "VAL "
            if r == bestBuy
                tag += "Buyers max "
            if r == bestSell
                tag += "Sellers max "
            if b >= s * imbX and b > 0
                tag += "Buy imbalance"
            else if s >= b * imbX and s > 0
                tag += "Sell imbalance"
            ld.cell(0, rowI, fp(bot + step * (r + 0.5)), text_color = cTxt, bgcolor = r == cr ? color.new(color.yellow, 55) : na, text_size = tz)
            ld.cell(1, rowI, fn(s), text_color = cTxt, bgcolor = color.new(color.red, 100 - 75 * s / mx), text_size = tz)
            ld.cell(2, rowI, fn(b), text_color = cTxt, bgcolor = color.new(color.teal, 100 - 75 * b / mx), text_size = tz)
            ld.cell(3, rowI, fd(b - s), text_color = b >= s ? color.teal : color.red, text_size = tz)
            ld.cell(4, rowI, tag, text_color = r == pocIdx or r == hi or r == lo ? cPoc : cTxt, text_size = tz)
            rowI += 1
